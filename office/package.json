{
  "name": "pi-office",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Embedded AIOffice docs editor for python-pi (Apache-2.0 fork)",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "npm run build:docs && npm run build:slides && npm run build:sheets",
    "build:docs": "vite --config vite.config.ts build",
    "build:slides": "vite --config apps/slides/vite.config.ts build",
    "build:sheets": "vite --config apps/sheets/vite.config.ts build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tiptap/core": "^3.28.0",
    "@tiptap/extensions": "^3.28.0",
    "@tiptap/pm": "^3.28.0",
    "@tiptap/react": "^3.28.0",
    "bidi-js": "^1.0.3",
    "buffer": "^6.0.3",
    "fast-xml-parser": "^5.3.4",
    "jszip": "^3.10.1",
    "opentype.js": "^2.0.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "acorn": "^8.18.0",
    "harfbuzzjs": "^1.4.0",
    "konva": "^9.3.20",
    "pngjs": "^7.0.0",
    "react-konva": "^19.0.10",
    "utif2": "^4.1.0",
    "@univerjs/core": "0.25.1",
    "@univerjs/preset-sheets-conditional-formatting": "0.25.1",
    "@univerjs/preset-sheets-core": "0.25.1",
    "@univerjs/preset-sheets-data-validation": "0.25.1",
    "@univerjs/preset-sheets-drawing": "0.25.1",
    "@univerjs/preset-sheets-filter": "0.25.1",
    "@univerjs/preset-sheets-find-replace": "0.25.1",
    "@univerjs/preset-sheets-note": "0.25.1",
    "@univerjs/preset-sheets-sort": "0.25.1",
    "@univerjs/preset-sheets-table": "0.25.1",
    "@univerjs/sheets-filter": "0.25.1",
    "@univerjs/themes": "0.25.1",
    "rxjs": "^7.8.1",
    "zod": "^4.3.6",
    "@fluentui/react-icons": "^2.0.333"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/opentype.js": "^1.3.8",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
