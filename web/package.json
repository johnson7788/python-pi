{
  "name": "python-pi-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Web UI for the python-pi coding agent (Vite + React 18 + TypeScript).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "mock": "node mock-server.mjs",
    "verify:mock": "node scripts/verify-mock.mjs",
    "verify:dom": "node scripts/verify-dom.mjs",
    "verify": "npm run typecheck && npm run verify:dom && npm run verify:dom:team && npm run verify:transcript",
    "verify:transcript": "node scripts/verify-transcript.mjs",
    "verify:dom:team": "node scripts/verify-dom.mjs --team"
  },
  "dependencies": {
    "dompurify": "^3.2.4",
    "marked": "^14.1.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^29.1.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "ws": "^8.18.0"
  }
}
