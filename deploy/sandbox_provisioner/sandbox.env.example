# Shared secret between the server and the provisioner. Generate one:
#   python -c 'import secrets; print(secrets.token_urlsafe(32))'
# The provisioner refuses every request when this is unset, rather than running open.
SANDBOX_PROVISIONER_TOKEN=

# The image every sandbox container is built from. Build the one in ../sandbox_image/ for a
# toolchain that can actually do work; the default is a bare Python image.
SANDBOX_IMAGE=pi-sandbox:latest

# Network for sandbox containers. `none` is the strict choice: the agent cannot fetch
# anything, which also means `pip install` and `git clone` stop working.
SANDBOX_NETWORK=bridge

# A container nobody has used for this long is removed. It is the backstop for a server
# that died without releasing its sandboxes.
SANDBOX_IDLE_TIMEOUT_SECONDS=900

# Ceiling for a single command, applied inside the container by `timeout`.
SANDBOX_EXEC_TIMEOUT_SECONDS=180

SANDBOX_MEMORY_LIMIT=2g
SANDBOX_CPUS=2
SANDBOX_PIDS_LIMIT=512
