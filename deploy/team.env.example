# Environment for the team deployment, installed as /etc/pi/pi.env (mode 0640, owner root).
#
#   sudo install -d -m 0750 -o root -g pi /etc/pi
#   sudo install -m 0640 -o root -g pi deploy/team.env.example /etc/pi/pi.env
#
# Only deployment-level settings belong here. Per-session settings (model, thinking level,
# extensions) are not read from this file — see docs/DEPLOY.md.

# Multi-tenant: every request must carry a session, and each account gets its own cwd and
# agent directory under PI_DATA_ROOT.
PI_AUTH_MODE=team

# Everything stateful lives here: pi.db, workspaces/<uid>/, agents/<uid>/.
# The systemd unit grants write access to exactly this tree.
PI_DATA_ROOT=/var/lib/pi

# Name of the first superadmin, created on the first start with a generated password that
# is printed once and must be changed at first login. Ignored after the first account exists.
PI_ADMIN_USERNAME=admin

# 14 days. Sessions are server-side rows, so lowering this takes effect on the next request
# and disabling an account invalidates its sessions immediately.
PI_SESSION_TTL_HOURS=336

# Concurrent live sessions per process. Each one costs a bootstrapped session, so this is a
# memory bound as much as a fairness one; sessions are released after the idle timeout.
PI_MAX_ACTIVE_USERS=20
PI_SESSION_IDLE_MINUTES=30

# The model credential is NOT set here. It belongs in /etc/pi/api_key (mode 0600, root),
# named by LoadCredential in the unit and read through PI_API_KEY_FILE. Putting it in this
# file would make it readable by anything in the `pi` group; putting it in argv would
# publish it to every account via `ps`.
#
# For a quick trial without systemd you may set it directly:
# PI_API_KEY=sk-xxxxxxxxxxxxxxxx

# Where a new user's agent directory is primed from: models.json, settings.json, AGENTS.md
# are copied once, and skills/ is symlinked. Defaults to <PI_DATA_ROOT>/template.
# Create it before the first login if your provider needs a baseUrl override:
#   sudo -u pi mkdir -p /var/lib/pi/template
#   sudo -u pi cp ~/.pi/agent/models.json /var/lib/pi/template/
#
# Setting this to a directory that does not exist is silent — users simply get the built-in
# model catalog. If model selection fails, check here first.
# PI_TEMPLATE_AGENT_DIR=/var/lib/pi/template

# Secures the cookie to HTTPS. Requires the reverse proxy from deploy/Caddyfile; turning it
# off on an HTTPS deployment leaves the session cookie sendable over plaintext.
PI_COOKIE_SECURE=1

# Phase two only. Setting this today makes the server refuse to start rather than silently
# running commands in-process — which is the correct behaviour, and the reason it is
# commented out.
# PI_SANDBOX_BACKEND=local
# PI_SANDBOX_PROVISIONER_URL=http://sandbox-provisioner:8002
