  },
  "option": {
    "dataset": {},
    "tooltip": {
      "position": "top"
    },
    "grid": {
      "left": 72,
      "right": 104,
      "top": 24,
      "bottom": 48
    },
    "xAxis": {
      "type": "category",
      "name": "时段",
      "splitArea": {
        "show": true
      }
    },
    "yAxis": {
      "type": "category",
      "name": "星期",
      "splitArea": {
        "show": true
      },
      "inverse": true
    },
    "visualMap": {
      "min": 0,
      "max": 40,
      "calculable": true,
      "orient": "vertical",
      "right": 12,
      "top": "center",
      "itemHeight": 110
    },
    "series": [
      {
        "type": "heatmap",
        "encode": {
          "x": "hour",
          "y": "weekday",
          "value": "count"
        },
        "label": {
          "show": false
        }
      }
    ]
  },
  "title": "周二中午是高峰",
  "note": "颜色是分档的，具体值看 tooltip 或标注；色阶要有图例",
  "notes": {
    "unit": "次",
    "caveat": ""
  },
  "pitfalls": [
    "visualMap 的 min/max 用数据范围，别用 0–100 默认值",
    "色阶不要用红绿（色盲）；色阶放在图外，别压住轴标签"
  ],
  "schema": "pi.chart-template/1"
}
