{
  "id": "heatmap",
  "name": "热力图（二维密度）",
  "family": "distribution",
  "use": "两个类目维度 × 数值（星期 × 小时、科室 × 月份）",
  "avoid": "两个维度都超过 15 档（格子太小）；只需要看总量",
  "bind": {
    "columns": [
      "weekday",
      "hour",
      "count"
    ]
  },
  "sample": {
    "columns": [
      "weekday",
      "hour",
      "count"
    ],
    "rows": [
      [
        "周一",
        "9",
        12
      ],
