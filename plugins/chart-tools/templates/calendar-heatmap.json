{
  "id": "calendar-heatmap",
  "name": "日历热力图",
  "family": "distribution",
  "use": "一年里每天的量（活跃、发稿、门诊量）",
  "avoid": "时间跨度超过一年；数据点很少（>70% 空白）",
  "bind": null,
  "sample": null,
  "option": {
