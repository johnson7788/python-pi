{
  "id": "treemap",
  "name": "矩形树图",
  "family": "composition",
  "use": "层级 + 占比，比饼图能容纳更多类目",
  "avoid": "层级超过两层；需要比较具体数值",
  "bind": null,
  "sample": null,
  "dataNote": "结构性层级数据：data 里写 children，数值来自 chart_data_profile 的汇总",
  "option": {
    "tooltip": {
      "formatter": "{b}: {c}"
    },
    "series": [
      {
        "type": "treemap",
        "roam": false,
        "nodeClick": false,
        "breadcrumb": {
          "show": false
        },
        "width": "100%",
        "height": "100%",
        "top": 8,
        "bottom": 8,
        "label": {
          "show": true,
          "formatter": "{b}"
        },
        "upperLabel": {
          "show": true,
          "height": 22
        },
        "levels": [
          {
            "itemStyle": {
              "borderWidth": 0,
              "gapWidth": 2
            }
          },
          {
            "itemStyle": {
              "borderWidth": 2,
              "gapWidth": 2
            }
          }
        ],
        "data": [
          {
            "name": "线上",
            "children": [
              {
                "name": "自营",
                "value": 40
              },
              {
                "name": "平台",
                "value": 25
              }
            ]
          },
          {
            "name": "线下",
            "children": [
              {
                "name": "直营",
                "value": 20
              },
              {
                "name": "经销",
                "value": 15
              }
            ]
          }
        ]
      }
    ]
  },
  "title": "线上自营是最大的一块",
  "note": "面积编码占比，同一层级可比，跨层级不可比",
  "notes": {
    "unit": "%",
    "caveat": "按 GMV 计"
  },
  "pitfalls": [
    "跨层级的面积不能直接比",
    "层级超过两层改为 sunburst 或拆图"
  ],
  "schema": "pi.chart-template/1"
}
